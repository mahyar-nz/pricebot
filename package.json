{
  "name": "untitled-pricing-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.11 <25" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "db:generate": "pnpm --filter @pricing/api db:generate",
    "db:migrate": "pnpm --filter @pricing/api db:migrate",
    "db:seed": "pnpm --filter @pricing/api db:seed",
    "admin:create": "pnpm --filter @pricing/api admin:bootstrap",
    "dev": "node --env-file=.env scripts/dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "node --env-file=.env --test tests/e2e.test.mjs",
    "test:otp": "node --env-file=.env --test tests/otp.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}

