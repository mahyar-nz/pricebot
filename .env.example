# Generate development secrets with pnpm setup. Never reuse local secrets in production.
NODE_ENV=development
DATABASE_URL=postgresql://pricing:CHANGE_ME@127.0.0.1:54329/pricing
POSTGRES_USER=pricing
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pricing
POSTGRES_PORT=54329
API_PORT=4000
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_BASE64
REDIS_URL=redis://127.0.0.1:6379
SMS_PROVIDER=disabled
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_VALIDATED=false
# Optional: notification delivery and payment providers remain disabled until implemented/configured.
PAYMENT_PROVIDER=disabled
LOG_LEVEL=info
